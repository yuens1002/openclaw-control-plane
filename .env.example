# OPENCLAW_INSTANCE_SETUP_PASSWORD/USERNAME are the *target OpenClaw
# instance's* setup credentials, used only by packages/openclaw-setup-applier's
# apply path. See docs/setup-profile-applier.md.
# OPENROUTER_MANAGEMENT_KEY=change-me
# OPENCLAW_INSTANCE_SETUP_PASSWORD=change-me
# OPENCLAW_INSTANCE_SETUP_USERNAME=openclaw
