DATABASE_URL=postgres://openclaw:openclaw@localhost:5432/openclaw_control_plane
PORT=8787
# SETUP_PASSWORD/OPENCLAW_SETUP_USERNAME gate this repo's own apps/api.
# OPENCLAW_INSTANCE_SETUP_PASSWORD/USERNAME (below) are a different,
# deliberately distinctly-named pair: the *target OpenClaw instance's*
# setup credentials, used only by packages/openclaw-setup-applier's apply
# path. See docs/setup-profile-applier.md.
# SETUP_PASSWORD=change-me
# OPENCLAW_SETUP_USERNAME=openclaw
# OPENROUTER_MANAGEMENT_KEY=change-me
# OPENCLAW_INSTANCE_SETUP_PASSWORD=change-me
# OPENCLAW_INSTANCE_SETUP_USERNAME=openclaw
