{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@openclaw-control-plane/contracts": ["packages/contracts/src/index.ts"],
      "@openclaw-control-plane/db": ["packages/db/src/index.ts"],
      "@openclaw-control-plane/openclaw-adapter": ["packages/openclaw-adapter/src/index.ts"],
      "@openclaw-control-plane/vending-worker": ["workers/vending/src/index.ts"]
    }
  }
}
